{
  "name": "linklens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that shows where a link really goes and flags phishing tricks.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --test \".test-build/*.test.mjs\"",
    "zip": "node build.mjs && cd extension && zip -qr ../linklens.zip ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
