{
  "manifest_version": 3,
  "name": "LinkLens",
  "version": "0.1.0",
  "description": "Hover a link to see where it really goes. Flags look-alike domains, hidden destinations and other phishing tricks. Works offline.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "LinkLens" },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
